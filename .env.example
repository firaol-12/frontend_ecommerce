# ============================================================================
# Copy this file to .env.local and fill in real values.
# On Vercel: Project -> Settings -> Environment Variables -> add each key below.
# Nothing here is prefixed with NEXT_PUBLIC_, because every value is used only
# by server-side code (route handlers). Secrets must never be NEXT_PUBLIC_*.
# ============================================================================

# --- Database (REQUIRED) ----------------------------------------------------
# Use a POOLED connection string in production. Serverless functions open many
# short-lived connections; a pooled endpoint (Neon "-pooler", Supabase
# ":6543/postgres", Vercel Postgres) is what prevents "too many connections".
# Local example:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# Neon example:
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# Force TLS on/off. Optional — by default TLS is enabled automatically unless
# the host is localhost/127.0.0.1 (managed Postgres needs it, local doesn't).
# PGSSL=true

# --- Auth (REQUIRED) --------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Google OAuth (required for "Sign in with Google") ----------------------
# In Google Cloud Console add BOTH authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   https://YOUR-PROJECT.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Where the OAuth callback sends the browser back to (your app's own origin).
FRONTEND_URL=http://localhost:3000

# --- Chapa payments (required for checkout) --------------------------------
CHAPA_SECRET_KEY=
# Webhook Encryption key from the Chapa dashboard; used to verify signatures.
CHAPA_WEBHOOK_SECRET=
CHAPA_API_URL=https://api.chapa.co
# Public base URL of THIS app; Chapa redirects the browser here after payment.
# In production set it to https://YOUR-PROJECT.vercel.app
CHAPA_CALLBACK_URL=http://localhost:3000
# A real inbox Chapa accepts. Chapa rejects @test.com / @example.com /
# disposable domains, so accounts with those addresses fall back to this value.
# Leave blank in production.
CHAPA_TEST_EMAIL=

# --- Optional ---------------------------------------------------------------
# Only set if you deliberately point the frontend at a DIFFERENT backend.
# When unset, the frontend calls the same-origin /api routes in this app.
# NEXT_PUBLIC_API_URL=
